# ========================================
# Production / Self-Hosted Environment
# ========================================
# This file is a template for .env
# Use this for:
# - Production / Vercel deployments
# - Self-hosted production instances
#
# For local Docker development, use:
# ./scripts/docker-start.sh
# which will generate .env.docker automatically
# ========================================

# App URL
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# Supabase (Client)
# Get these from your managed Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server)
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET= # Must match your Supabase JWT secret

# AI Engine (OpenAI - for transcript analysis)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Google Cloud / Vertex AI (for AI Call Reviews)
# Required for the AI-powered call review feature (uses Gemini via Vertex AI)
# 1. Create a Google Cloud project and enable the Vertex AI API
# 2. Create a service account with Vertex AI permissions
# 3. Download the JSON key file and place it at src/credentials/google-credentials.json
#    OR set GOOGLE_APPLICATION_CREDENTIALS to the absolute path of your key file
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Optional: AWS (for S3 storage if enabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Trillet Evals Configuration
TRILLET_EVALS_MASTER_KEY= # Generate a strong secret
TRILLET_API_URL=https://api.trillet.ai

